{
  "name": "busflow-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Multi-branch bus transportation MVP",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/src/index.js",
    "check": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "db:migrate": "tsx src/migrate.ts",
    "test:integration": "tsx src/integration.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
